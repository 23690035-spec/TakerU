{
  "expo": {
    "name": "TecSolv",
    "slug": "tecsolv",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tecsolv",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "mx.edu.itcv.tecsolv",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1E4FD8"
        }
      ]
    ]
  }
}
